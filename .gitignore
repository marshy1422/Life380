# ===================
# Life380 iOS Project .gitignore
# ===================

# Build artifacts
*.xcarchive
build/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip

# Xcode user data
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xccheckout
*.xcscmblueprint
*.hmap
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Xcode workspaces
*.xcworkspace
!default.xcworkspace
xcuserdata
!*.xcodeproj/project.xcworkspace/

# SwiftPM
.swiftpm/
Package.resolved
.build/

# CocoaPods (if used in future)
Pods/
Podfile.lock

# Carthage (if used in future)
Carthage/Build/
Carthage/Checkouts/

# macOS files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# IDEs
*.swp
*.swo
*~
.idea/
*.iml
.vscode/

# Secrets and credentials - NEVER commit these
*.p12
*.cer
*.mobileprovision
*.provisionprofile
Secrets/
credentials/
.env
.env.*
!.env.example
*.key
*.pem
authkey*.p8

# Firebase (keep GoogleService-Info.plist but be careful)
# NOTE: GoogleService-Info.plist contains non-secret Firebase config
# If you have different configs per environment, consider:
# firebase/
# !firebase/GoogleService-Info-example.plist

# API keys and secrets (if stored in separate files)
secrets.xcconfig
Debug.xcconfig
Release.xcconfig
*.xcconfig
!*.xcconfig.example

# Test artifacts
*.xcresult
coverage/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Crash logs
*.crash
*.ips

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Archives (generated by Xcode)
Archives/

# Temporary files
*.tmp
*.temp
*.log

# Instruments
*.trace

# App Store Connect
*.appex/

# Local configuration (for developer-specific settings)
local.xcconfig
.claude/
