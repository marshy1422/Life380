rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCircleMember(circleId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/circles/$(circleId)) &&
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds;
    }

    function isValidDisplayName(name) {
      return name is string && name.size() >= 1 && name.size() <= 100;
    }

    function isValidLatitude(lat) {
      return lat is number && lat >= -90 && lat <= 90;
    }

    function isValidLongitude(lng) {
      return lng is number && lng >= -180 && lng <= 180;
    }

    function isValidBatteryLevel(level) {
      return level is number && level >= 0 && level <= 100;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile OR profiles of circle members
      allow read: if isOwner(userId) ||
        (isAuthenticated() &&
         resource.data.circleIds != null &&
         resource.data.circleIds.hasAny(
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.circleIds
         ));

      // Users can only create their own profile
      allow create: if isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 1;

      // Users can only update their own profile
      allow update: if isOwner(userId);

      // Users can only delete their own profile
      allow delete: if isOwner(userId);
    }

    // Circles collection
    match /circles/{circleId} {
      // Circle members can read full details
      // Any authenticated user can read (needed for invite code lookup)
      allow read: if isAuthenticated();

      // Any authenticated user can create a circle
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid] &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 50 &&
        request.resource.data.inviteCode is string &&
        request.resource.data.inviteCode.size() == 6;

      // Circle members can update, AND new members can join
      allow update: if isAuthenticated() && (
        // Existing member can update
        isCircleMember(circleId) ||
        // New member joining: adding themselves to memberIds
        // Only allows adding exactly one member (themselves)
        (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
         request.resource.data.memberIds.hasAny([request.auth.uid]) &&
         !resource.data.memberIds.hasAny([request.auth.uid]))
      );

      // Only creator can delete (and only if they're the last member)
      allow delete: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid &&
        resource.data.memberIds.size() <= 1;

      // Places subcollection
      match /places/{placeId} {
        allow read: if isCircleMember(circleId);

        allow create: if isCircleMember(circleId) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 1 &&
          request.resource.data.name.size() <= 100 &&
          isValidLatitude(request.resource.data.latitude) &&
          isValidLongitude(request.resource.data.longitude);

        allow update: if isCircleMember(circleId);

        allow delete: if isCircleMember(circleId);
      }

      // SOS Alerts subcollection - CRITICAL for emergency features
      match /sosAlerts/{alertId} {
        allow read: if isCircleMember(circleId);

        // Only allow creating alerts for yourself
        allow create: if isCircleMember(circleId) &&
          request.resource.data.userId == request.auth.uid;

        // Allow updates (to resolve alerts) by circle members
        allow update: if isCircleMember(circleId);

        // Never allow deletion of SOS alerts (audit trail)
        allow delete: if false;
      }

      // Check-ins subcollection
      match /checkIns/{checkinId} {
        allow read: if isCircleMember(circleId);

        // Only allow creating check-ins for yourself
        allow create: if isCircleMember(circleId) &&
          request.resource.data.userId == request.auth.uid;

        // Never allow deletion of check-ins
        allow delete: if false;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
